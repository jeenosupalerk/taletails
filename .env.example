# ---------------------------------------------------------------------------
# ตัวอย่างค่า environment สำหรับรันบนเซิร์ฟเวอร์ Node.js ของคุณเอง (Hostatom / Plesk)
# คัดลอกเป็นไฟล์ .env บนเซิร์ฟเวอร์ แล้วใส่ค่าจริง (ห้าม commit ขึ้น GitHub)
# ---------------------------------------------------------------------------

# ---- โดเมนหลักของเว็บ (ใช้ในลิงก์ในอีเมลแจ้งเตือน) ----
PUBLIC_SITE_URL=https://taletails-trade.com

# ---- Supabase (ฝั่งเบราว์เซอร์) ----
VITE_SUPABASE_URL=https://biuyjlrovmcpyqczmaje.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=biuyjlrovmcpyqczmaje

# ---- Supabase (ฝั่งเซิร์ฟเวอร์) ----
SUPABASE_URL=https://biuyjlrovmcpyqczmaje.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- ตัวตั้งเวลาอัตโนมัติ (ปิดประมูล / หมดเวลาชำระ / ส่งอีเมล / ส่งแจ้งเตือน) ----
# สุ่มค่าเองด้วย: openssl rand -hex 32
CRON_SECRET=

# ---- อีเมล (Resend) ----
RESEND_API_KEY=
RESEND_FROM=Taletails <no-reply@taletails-trade.com>

# ---- การแจ้งเตือนแบบ Push (VAPID) ----
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@taletails-trade.com

# ---- Stripe / PromptPay อัตโนมัติ (ปิดอยู่: เว้นว่างไว้ได้) ----
# ใส่ค่าเมื่อพร้อมเปิดใช้งาน แล้วรีสตาร์ทเซิร์ฟเวอร์
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
